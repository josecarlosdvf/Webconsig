# True for development, False for production
DEBUG=True

# Flask ENV
FLASK_APP=run.py
FLASK_DEBUG=1

# If not provided, a random one is generated 
# SECRET_KEY=<YOUR_SUPER_KEY_HERE>

# PostgreSQL Database Configuration (Production)
# Uncomment and configure for PostgreSQL in production
# DB_ENGINE=postgresql
# DB_NAME=webconsig_db
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=webconsig_user
# DB_PASS=<STRONG_PASSWORD_HERE>

# SQLite is used by default in development if PostgreSQL is not configured

# SOCIAL AUTH Github (Optional)
# GITHUB_ID=YOUR_GITHUB_ID
# GITHUB_SECRET=YOUR_GITHUB_SECRET

# SOCIAL AUTH Google (Optional)
# GOOGLE_ID=YOUR_GOOGLE_ID
# GOOGLE_SECRET=YOUR_GOOGLE_SECRET
